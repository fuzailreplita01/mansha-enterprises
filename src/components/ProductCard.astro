---
/**
 * Product listing card — used on the Buy Products page.
 */
import WhatsAppButton from './WhatsAppButton.astro';

interface Props {
  id: string;
  name: string;
  brand: string;
  category: string;
  price: number;
  condition: string;
  description?: string;
  storage?: string;
  color?: string;
  specCapacity?: string;
  specType?: string;
  whatsappMsg: string;
}

const {
  id,
  name,
  brand,
  category,
  price,
  condition,
  description,
  storage,
  color,
  specCapacity,
  specType,
  whatsappMsg,
} = Astro.props;

// Format price in Indian Rupees format
const formattedPrice = `₹${price.toLocaleString('en-IN')}`;

// Condition badge colors
const conditionStyle = {
  'New':       'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20',
  'Like New':  'bg-teal-500/10 text-teal-600 dark:text-teal-400 border-teal-500/20',
  'Excellent': 'bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 border-emerald-500/20',
  'Good':      'bg-blue-500/10 text-blue-600 dark:text-blue-400 border-blue-500/20',
  'Fair':      'bg-amber-500/10 text-amber-600 dark:text-amber-400 border-amber-500/20',
}[condition] || 'bg-muted text-muted-foreground border-border';

// Formulate category details text
let specsText = '';
if (category === 'Mobiles') {
  const parts = [storage, color].filter(Boolean);
  specsText = parts.join(' · ');
} else if (category === 'Air Conditioners' || category === 'Water Purifiers') {
  const parts = [specCapacity, specType].filter(Boolean);
  specsText = parts.join(' · ');
} else if (color) {
  specsText = color;
}

// Category Icon mapping (Lucide style)
const categoryIcons: Record<string, string> = {
  'Mobiles': `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>`,
  'Air Conditioners': `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="12" x="2" y="6" rx="2"/><path d="M6 12h12"/><path d="M14 15v3"/><path d="M10 15v3"/></svg>`,
  'Water Purifiers': `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22a7 7 0 0 0 7-7c0-4.3-7-11-7-11S5 10.7 5 15a7 7 0 0 0 7 7z"/></svg>`,
  'Accessories': `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 1 1-4 0V7a2 2 0 1 1 4 0v5Z"/></svg>`
};

const categoryIcon = categoryIcons[category] || `<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>`;
---

<div 
  class="product-card card-chrome flex flex-col hover:shadow-[var(--shadow-lift)] transition-all duration-200 group rounded-2xl" 
  data-category={category}
  data-condition={condition}
>
  <!-- Details -->
  <div class="flex flex-col flex-1 gap-3 p-5">
    <div class="flex items-start justify-between gap-4">
      <div>
        <div class="flex items-center gap-1.5 mb-1 text-[10px] text-[var(--muted-foreground)] font-bold uppercase tracking-widest">
          <span class="text-brand shrink-0" set:html={categoryIcon} />
          <span>{category}</span>
        </div>
        <p class="text-xs text-[var(--muted-foreground)] font-semibold uppercase tracking-wider">{brand}</p>
        <h3 class="font-semibold text-[var(--foreground)] text-base leading-snug mt-0.5">{name}</h3>
        {specsText && (
          <p class="text-xs text-[var(--muted-foreground)] mt-0.5 font-medium">{specsText}</p>
        )}
      </div>
      <!-- Condition badge -->
      <span class:list={['text-[9px] font-black px-2.5 py-0.5 rounded-full border uppercase tracking-wider shrink-0 mt-0.5', conditionStyle]}>
        {condition}
      </span>
    </div>

    {description && (
      <p class="text-xs text-[var(--muted-foreground)] bg-brand/5 border border-brand/10 rounded-md px-3 py-2 leading-relaxed mt-1">
        {description}
      </p>
    )}

    <!-- Price + CTA -->
    <div class="flex flex-col gap-3 mt-auto pt-3 border-t border-[var(--border)]/30">
      <p class="text-xl font-bold text-[var(--foreground)] tracking-tight">{formattedPrice}</p>
      <WhatsAppButton
        message={whatsappMsg}
        label="Enquire on WhatsApp"
        size="md"
        variant="outline"
        fullWidth
      />
    </div>
  </div>
</div>
