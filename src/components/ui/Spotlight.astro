---
/**
 * Lightweight, high-performance Spotlight component.
 * Uses vanilla JS and CSS translate3d to follow the mouse on hover.
 * Zero dependencies (no React, no Framer Motion).
 */
interface Props {
  size?: number;
  className?: string;
}

const { size = 300, className = "" } = Astro.props;
const id = `spotlight-${Math.random().toString(36).substring(2, 9)}`;
---

<div
  id={id}
  class={`pointer-events-none absolute rounded-full blur-2xl opacity-0 transition-opacity duration-300 bg-[radial-gradient(circle_at_center,rgba(250,255,105,0.18),rgba(250,255,105,0.05),transparent_70%)] ${className}`}
  style={`width: ${size}px; height: ${size}px; will-change: transform; transform: translate3d(0, 0, 0);`}
>
</div>

<script is:inline define:vars={{ id, size }}>
  (function() {
    const spotlight = document.getElementById(id);
    if (!spotlight) return;

    let parent = spotlight.parentElement;
    if (parent && parent.tagName.toLowerCase() === 'astro-island') {
      parent = parent.parentElement;
    }
    if (!parent) return;

    parent.style.position = 'relative';
    parent.style.overflow = 'hidden';

    let active = false;

    const onEnter = () => {
      active = true;
      spotlight.style.opacity = '1';
    };

    const onLeave = () => {
      active = false;
      spotlight.style.opacity = '0';
    };

    const onMove = (e) => {
      if (!active) {
        active = true;
        spotlight.style.opacity = '1';
      }
      const rect = parent.getBoundingClientRect();
      const x = e.clientX - rect.left - size / 2;
      const y = e.clientY - rect.top - size / 2;
      
      requestAnimationFrame(() => {
        spotlight.style.transform = `translate3d(${x}px, ${y}px, 0)`;
      });
    };

    parent.addEventListener('mousemove', onMove);
    parent.addEventListener('mouseenter', onEnter);
    parent.addEventListener('mouseleave', onLeave);
  })();
</script>
