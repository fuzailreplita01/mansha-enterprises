---
/**
 * FAQSection — Accordion UI + FAQPage JSON-LD for Google rich results.
 *
 * Usage:
 *   import FAQSection from '../components/FAQSection.astro';
 *   import { faqs } from '../data/faqs.js';
 *   <FAQSection faqs={faqs} />
 *
 * JSON-LD is emitted inline (Google accepts it in <body> per spec).
 * Validate at: https://search.google.com/test/rich-results
 */

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  faqs: FAQItem[];
  title?: string;
  eyebrow?: string;
  bg?: string;
  id?: string;
}

const {
  faqs,
  title = 'Frequently asked questions.',
  eyebrow = 'FAQ',
  bg = 'bg-white',
  id = 'faq',
} = Astro.props;

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ question, answer }) => ({
    '@type': 'Question',
    name: question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: answer,
    },
  })),
};
---

<!-- FAQPage JSON-LD — valid in <body> per Google's spec -->
<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class={`py-16 sm:py-20 ${bg}`} aria-labelledby={`${id}-heading`}>
  <div class="container-page">
    <div class="max-w-2xl mx-auto">

      <!-- Heading -->
      <div class="text-center mb-10">
        <p class="eyebrow">{eyebrow}</p>
        <h2
          id={`${id}-heading`}
          class="heading-tight text-3xl sm:text-4xl text-[var(--foreground)] mt-2"
        >
          {title}
        </h2>
        <p class="mt-3 text-sm text-slate-500">
          Still have questions? <a href="/contact" class="text-brand hover:underline underline-offset-2">Contact us</a> or <a href="tel:+917262080880" class="text-brand hover:underline underline-offset-2">call +917262080880</a>.
        </p>
      </div>

      <!-- Accordion list -->
      <div class="divide-y divide-[var(--border)] border-y border-[var(--border)]">
        {faqs.map((item) => (
          <details class="faq-details group" name="faq">
            <summary class="flex items-center justify-between gap-4 py-4 sm:py-5 cursor-pointer select-none">
              <span class="text-sm sm:text-base font-medium text-[var(--foreground)] group-hover:text-brand transition-colors duration-150 text-left">
                {item.question}
              </span>
              <!-- Chevron -->
              <svg
                class="faq-chevron w-4 h-4 text-slate-400 shrink-0"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>

            <!-- Height-animating wrapper (grid trick: 0fr → 1fr) -->
            <div class="faq-body">
              <div class="faq-body-inner">
                <p class="pb-5 pt-1 text-sm text-[var(--muted-foreground)] leading-relaxed pr-6">
                  {item.answer}
                </p>
              </div>
            </div>
          </details>
        ))}
      </div>

    </div>
  </div>
</section>

<!-- is:global so that details[open] parent-state selectors compile correctly -->
<style is:global>
  /* Remove default triangle marker across all browsers */
  .faq-details > summary::-webkit-details-marker { display: none; }
  .faq-details > summary { list-style: none; }

  /* Smooth height animation via CSS grid rows */
  .faq-details .faq-body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.22s ease-out;
  }
  .faq-details[open] .faq-body {
    grid-template-rows: 1fr;
  }
  .faq-details .faq-body-inner {
    overflow: hidden;
  }

  /* Chevron rotation */
  .faq-details .faq-chevron {
    transition: transform 0.22s ease-out;
  }
  .faq-details[open] .faq-chevron {
    transform: rotate(180deg);
  }
</style>
