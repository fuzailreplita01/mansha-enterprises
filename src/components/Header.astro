---
import WhatsAppButton from './WhatsAppButton.astro';

/* Primary nav items with high-fidelity icons */
const navLinks = [
  { 
    href: '/services',    
    label: 'Services',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`
  },
  { 
    href: '/buy-phones',  
    label: 'Buy Phones',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="14" height="20" x="5" y="2" rx="2" ry="2"/><path d="M12 18h.01"/></svg>`
  },
  { 
    href: '/accessories', 
    label: 'Accessories',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 18h8"/><path d="M3 22h18"/><path d="M14 22a7 7 0 1 0 0-14h-1"/><path d="M9 14h2"/><path d="M9 12a2 2 0 1 1-4 0V7a2 2 0 1 1 4 0v5Z"/></svg>`
  },
  { 
    href: '/about',       
    label: 'About',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4"/><path d="M12 8h.01"/></svg>`
  },
  { 
    href: '/faq',         
    label: 'FAQ',
    icon: `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>`
  },
];
---

<!-- —— Header wrapper —— -->
<header
  id="main-header"
  class="fixed top-0 left-0 right-0 z-50 h-16 transition-all duration-300 border-b border-transparent"
>
  <div class="container-page h-full flex items-center justify-between gap-4">
    
    <div class="flex items-center gap-8">
      <!-- —— Logo —— -->
      <a
        href="/"
        class="flex items-center gap-3 group transition-transform active:scale-95"
        aria-label="Mansha Enterprises — homepage"
      >
        <!-- The geometric monogram mark -->
        <svg viewBox="0 0 200 200" class="w-10 h-10 shrink-0 filter drop-shadow-[0_2px_8px_rgba(250,255,105,0.15)] group-hover:drop-shadow-[0_2px_12px_rgba(250,255,105,0.35)] transition-all">
          <polyline points="44,152 44,56 100,122 156,56 156,152" fill="none" stroke="var(--primary)" stroke-width="22" stroke-linecap="square" stroke-linejoin="miter"/>
        </svg>

        <!-- Text Lockup -->
        <div class="flex flex-col justify-center -space-y-1 select-none">
          <span class="font-display font-black text-xl sm:text-2xl tracking-tight leading-none text-foreground uppercase">
            Mansha
          </span>
          <span class="font-display font-bold text-[9px] sm:text-[10px] tracking-[0.28em] uppercase text-primary whitespace-nowrap leading-none pt-1">
            Enterprises
          </span>
        </div>
      </a>

      <!-- —— Desktop nav —— -->
      <nav class="hidden md:flex items-center gap-1" aria-label="Main navigation">
        {navLinks.map(link => (
          <a
            href={link.href}
            class="px-4 py-2 rounded-full text-sm font-bold text-muted-foreground hover:text-foreground hover:bg-accent transition-all uppercase tracking-widest text-[10px]"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- —— Desktop right cluster —— -->
    <div class="hidden md:flex items-center gap-3">
      <WhatsAppButton size="sm" variant="outline" label="Enquire Now" />
    </div>

    <!-- —— Mobile: toggle + sidebar trigger —— -->
    <div class="flex md:hidden items-center gap-2">
      <button
        id="sidebar-open"
        class="w-10 h-10 flex items-center justify-center rounded-lg bg-accent text-foreground active:scale-90 transition-transform cursor-pointer shadow-sm"
        aria-label="Open menu"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      </button>
    </div>

  </div>
</header>

<!-- —— Sidebar overlay —— -->
<div
  id="sidebar-backdrop"
  class="fixed inset-0 z-[60] bg-background/80 backdrop-blur-md hidden opacity-0 transition-opacity duration-300"
></div>

<!-- —— Sidebar panel —— -->
<aside
  id="nav-sidebar"
  class="fixed top-0 left-0 bottom-0 z-[70] w-[260px] bg-sidebar border-r border-border -translate-x-full transition-transform duration-300 ease-out flex flex-col shadow-2xl"
  aria-label="Navigation menu"
  role="dialog"
  aria-modal="true"
>
  <div class="p-4 border-b border-border flex items-center justify-between">
    <div class="flex items-center gap-2.5">
      <img src="/images/logo-mark.svg" alt="Mansha Enterprises Logo" class="w-7 h-7" />
      <span class="font-black text-foreground text-xs uppercase tracking-[0.2em]">Menu</span>
    </div>
    <button id="sidebar-close" class="p-2 -mr-2 text-muted-foreground hover:text-brand transition-colors cursor-pointer" aria-label="Close menu">
      <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" x2="6" y1="6" y2="18"/><line x1="6" x2="18" y1="6" y2="18"/></svg>
    </button>
  </div>

  <nav class="flex-1 overflow-y-auto p-4 space-y-1.5 custom-scrollbar" aria-label="Mobile navigation">
    <p class="text-[9px] font-black uppercase tracking-[0.3em] text-brand/60 px-3 mb-2">Quick Links</p>
    {navLinks.map(link => (
      <a
        href={link.href}
        class="sidebar-link group flex items-center gap-3 px-3 py-2.5 rounded-xl text-xs font-black text-muted-foreground hover:text-brand hover:bg-brand/5 transition-all border border-transparent hover:border-brand/10 shadow-sm"
      >
        <div class="p-1.5 rounded-lg bg-muted group-hover:bg-brand/10 transition-colors" set:html={link.icon} />
        <span class="uppercase tracking-widest">{link.label}</span>
        <svg class="ml-auto w-3.5 h-3.5 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="m9 18 6-6-6-6"/></svg>
      </a>
    ))}
  </nav>

  <div class="p-4 border-t border-border space-y-4 bg-muted/20">
    <WhatsAppButton fullWidth variant="outline" label="WhatsApp Enquiry" class="h-11 uppercase tracking-widest text-xs" />
    <div class="text-center space-y-1">
       <p class="text-[8px] font-black text-muted-foreground uppercase tracking-widest opacity-60">Customer Support Hours</p>
       <p class="text-[9px] font-black text-foreground uppercase tracking-tighter">Mon–Sat 9 AM–8 PM · Sun 10 AM–6 PM</p>
    </div>
  </div>
</aside>

<script is:inline>
  function setupHeader() {
    const header = document.getElementById('main-header');
    const openBtn = document.getElementById('sidebar-open');
    const closeBtn = document.getElementById('sidebar-close');
    const sidebar = document.getElementById('nav-sidebar');
    const backdrop = document.getElementById('sidebar-backdrop');

    // Scroll handling
    window.addEventListener('scroll', () => {
      if (window.scrollY > 20) {
        header.classList.add('bg-background/80', 'backdrop-blur-xl', 'border-border', 'shadow-lg', 'h-20');
        header.classList.remove('border-transparent', 'h-16');
      } else {
        header.classList.remove('bg-background/80', 'backdrop-blur-xl', 'border-border', 'shadow-lg', 'h-20');
        header.classList.add('border-transparent', 'h-16');
      }
    }, { passive: true });

    function open() {
      backdrop.classList.remove('hidden');
      requestAnimationFrame(() => {
        backdrop.classList.add('opacity-100');
        sidebar.classList.remove('-translate-x-full');
      });
      openBtn.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
    }

    function close() {
      backdrop.classList.remove('opacity-100');
      sidebar.classList.add('-translate-x-full');
      setTimeout(() => backdrop.classList.add('hidden'), 300);
      openBtn.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
    }

    openBtn?.addEventListener('click', open);
    closeBtn?.addEventListener('click', close);
    backdrop?.addEventListener('click', close);
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
    sidebar?.querySelectorAll('.sidebar-link').forEach(a => a.addEventListener('click', close));
  }

  // Initial load
  setupHeader();

  // Re-run for SPA logic if needed
  document.addEventListener('astro:after-swap', setupHeader);
</script>

<style>
  /* Sidebar scrollbar styling */
  .custom-scrollbar::-webkit-scrollbar { width: 4px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: var(--border); border-radius: 10px; }

  /* Navigation highlighting refinement */
  .sidebar-link:active {
    transform: scale(0.98);
  }
</style>
