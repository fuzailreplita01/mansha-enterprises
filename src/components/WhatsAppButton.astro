---
/**
 * WhatsApp button — styled to match the new brand system.
 * The WA icon keeps its brand green colour as a clear indicator.
 *
 * Props:
 *   message   — pre-filled chat message (plain text, encoded here)
 *   label     — visible button label
 *   size      — 'sm' | 'md' | 'lg'
 *   variant   — 'solid' (dark fill) | 'outline' (subtle border)
 *   fullWidth — stretch to container width
 *   class     — extra classes to merge
 */
interface Props {
  message?: string;
  label?: string;
  size?: 'sm' | 'md' | 'lg';
  variant?: 'solid' | 'outline';
  fullWidth?: boolean;
  class?: string;
}

const {
  message = "Hi, I found Mansha Enterprises online and would like to enquire about your products and services.",
  label   = 'WhatsApp Us',
  size    = 'md',
  variant = 'solid',
  fullWidth = false,
  class: extraClass = '',
} = Astro.props;

const href = `https://wa.me/917262080880?text=${encodeURIComponent(message)}`;

const sizeClass = {
  sm: 'h-9 px-4 text-xs gap-1.5',
  md: 'h-11 px-6 text-sm gap-2',
  lg: 'h-12 px-8 text-base gap-2.5',
}[size];

/* Theme-aware brand style — dark button with green accents */
const variantClass = {
  solid:   'bg-[#0A0A0A] hover:bg-[#161616] text-white border border-white/10 hover:border-[#25d366]/40 shadow-sm hover:shadow-[0_0_15px_rgba(37,211,102,0.12)] focus-visible:ring-[#25d366]',
  outline: 'border border-[#25d366]/20 bg-[#25d366]/[0.03] hover:bg-[#25d366]/[0.08] hover:border-[#25d366]/45 text-white focus-visible:ring-[#25d366]',
}[variant];
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`${label} — opens WhatsApp`}
  class:list={[
    'inline-flex items-center justify-center font-display font-semibold rounded-lg transition-all duration-200 active:scale-[0.98]',
    'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-offset-[#0A0A0A]',
    sizeClass,
    variantClass,
    fullWidth ? 'w-full' : '',
    extraClass,
  ]}
>
  <!-- WA icon -->
  <svg
    class:list={[
      "shrink-0 text-[#25d366]",
      size === 'sm' ? "w-3.5 h-3.5" : "w-4 h-4",
    ]}
    viewBox="0 0 24 24"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
    <path d="M12 0C5.373 0 0 5.373 0 12c0 2.025.507 3.934 1.395 5.61L0 24l6.545-1.371A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.794 9.794 0 01-5.003-1.373l-.36-.213-3.882.814.822-3.787-.234-.389A9.786 9.786 0 012.182 12c0-5.414 4.404-9.818 9.818-9.818 5.414 0 9.818 4.404 9.818 9.818 0 5.414-4.404 9.818-9.818 9.818z"/>
  </svg>
  {label}
</a>
