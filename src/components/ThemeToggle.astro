---
/* Theme toggle — sun/moon button with localStorage persistence */
---

<button
  type="button"
  aria-label="Toggle dark mode"
  title="Toggle dark / light mode"
  class="theme-toggle flex items-center justify-center w-9 h-9 rounded-full border border-border bg-card text-muted-foreground hover:text-foreground hover:bg-accent transition-colors cursor-pointer"
>
  <!-- Sun — shown in dark mode -->
  <svg class="tt-sun w-4 h-4 hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="5"/>
    <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
    <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
    <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
    <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
  </svg>
  <!-- Moon — shown in light mode -->
  <svg class="tt-moon w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/>
  </svg>
</button>

<script>
  function setupThemeToggles() {
    const btns = document.querySelectorAll('.theme-toggle');
    const html = document.documentElement;

    function updateAllIcons(isDark: boolean) {
      document.querySelectorAll('.tt-sun').forEach(el => el.classList.toggle('hidden', !isDark));
      document.querySelectorAll('.tt-moon').forEach(el => el.classList.toggle('hidden', isDark));
    }

    // Initial sync
    updateAllIcons(html.classList.contains('dark'));

    btns.forEach(btn => {
      // Remove existing listeners if any (relevant for SPA-like transitions if added later)
      const newBtn = btn.cloneNode(true);
      btn.parentNode?.replaceChild(newBtn, btn);
      
      newBtn.addEventListener('click', () => {
        const isDark = html.classList.toggle('dark');
        localStorage.setItem('theme', isDark ? 'dark' : 'light');
        updateAllIcons(isDark);
      });
    });
  }

  // Run on initial load
  setupThemeToggles();

  // Re-run if Astro view transitions are used (optional safety)
  document.addEventListener('astro:after-swap', setupThemeToggles);
</script>
