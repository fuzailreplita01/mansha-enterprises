---
/**
 * Privacy Policy page — standard privacy notice for the shop website.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';

const lastUpdated = '19 June 2026';
---

<BaseLayout
  title="Privacy Policy"
  description="Privacy Policy for Mansha Enterprises — how we collect, use, and protect your personal information."
  noIndex
>
  <PageHero
    eyebrow="Legal"
    title="Privacy <span class='bg-clip-text text-transparent bg-gradient-to-r from-brand via-brand-accent to-brand'>Policy.</span>"
    subtitle={`<strong>Last updated:</strong> ${lastUpdated}. How we handle your data.`}
  />

  <section class="bg-[var(--background)] py-16 sm:py-24">
    <div class="container-page">
      <div class="max-w-3xl space-y-10 text-base text-[var(--muted-foreground)] leading-relaxed">

        <div class="space-y-3">
          <h2 class="font-display text-xl font-bold text-[var(--foreground)] tracking-tight">1. Who we are</h2>
          <p>
            Mansha Enterprises ("Mansha Enterprises", "we", "us", "our") is a mobile phone, air conditioning (AC), and water purifier retail and service
            shop located in Alamgirnagar, Ahmednagar. We operate the website at mansha-enterprises.com ("the Site").
            This Privacy Policy explains how we handle personal information collected through the
            Site and our offline services.
          </p>
        </div>

        <div class="space-y-3">
          <h2 class="font-display text-xl font-bold text-[var(--foreground)] tracking-tight">2. Information we collect</h2>
          <p>We may collect the following categories of personal information:</p>
          <ul class="list-disc list-inside space-y-1 ml-2">
            <li><strong>Contact details</strong> — name, phone number, email address, and WhatsApp number when you submit an enquiry form or contact us directly.</li>
            <li><strong>Product or Service requirements</strong> — details of the mobile, AC, or water purifier unit and a description of the servicing/purchase request.</li>
            <li><strong>Communication records</strong> — messages sent to us via WhatsApp, phone, or email.</li>
            <li><strong>Usage data</strong> — standard server logs including IP address, browser type, and pages visited, collected automatically when you use the Site.</li>
          </ul>
        </div>

        <div class="space-y-3">
          <h2 class="font-display text-xl font-bold text-[var(--foreground)] tracking-tight">3. How we use your information</h2>
          <p>We use your personal information to:</p>
          <ul class="list-disc list-inside space-y-1 ml-2">
            <li>Respond to sales enquiries, installation requests, and service bookings.</li>
            <li>Contact you to confirm or follow up on your order, repair, or purchase.</li>
            <li>Maintain records of servicing or installation carried out at your home/office.</li>
            <li>Improve the Site and our services.</li>
            <li>Comply with legal obligations.</li>
          </ul>
          <p>We do not use your information for automated profiling or sell it to third parties.</p>
        </div>

        <div class="space-y-3">
          <h2 class="font-display text-xl font-bold text-[var(--foreground)] tracking-tight">4. Legal basis for processing</h2>
          <p>
            We process your personal data on the basis of your consent (when you submit a form),
            our legitimate interests in running our business, and compliance with applicable laws.
          </p>
        </div>

        <div class="space-y-3">
          <h2 class="font-display text-xl font-bold text-[var(--foreground)] tracking-tight">5. How we store and protect your data</h2>
          <p>
            Enquiry form data submitted on this Site is stored in a secure, hosted database
            (Supabase). We take reasonable technical and organisational measures to prevent
            unauthorised access, disclosure, or loss of your data.
          </p>
          <p>
            WhatsApp messages are stored on Meta's servers subject to WhatsApp's own Privacy Policy.
            Phone call records are retained as required by our business operations and applicable law.
          </p>
        </div>

        <div class="space-y-3">
          <h2 class="font-display text-xl font-bold text-[var(--foreground)] tracking-tight">6. How long we keep your data</h2>
          <p>
            We retain personal information for as long as necessary to provide our services and
            comply with legal requirements. Service records are typically kept for 2 years.
            You may request deletion of your data at any time (see section 8).
          </p>
        </div>

        <div class="space-y-3">
          <h2 class="font-display text-xl font-bold text-[var(--foreground)] tracking-tight">7. Sharing your information</h2>
          <p>
            We do not sell, rent, or trade your personal information. We may share data with:
          </p>
          <ul class="list-disc list-inside space-y-1 ml-2">
            <li>Service providers who help us operate the Site (e.g. Supabase for data storage).</li>
            <li>Law enforcement or regulatory bodies when required by law.</li>
          </ul>
        </div>

        <div class="space-y-3">
          <h2 class="font-display text-xl font-bold text-[var(--foreground)] tracking-tight">8. Your rights</h2>
          <p>You have the right to:</p>
          <ul class="list-disc list-inside space-y-1 ml-2">
            <li>Access the personal data we hold about you.</li>
            <li>Request correction of inaccurate data.</li>
            <li>Request deletion of your data.</li>
            <li>Withdraw consent at any time.</li>
          </ul>
          <p>To exercise any of these rights, contact us at <a href="mailto:mansha.enterprises.anagar@gmail.com" class="text-primary hover:underline">mansha.enterprises.anagar@gmail.com</a>.</p>
        </div>

        <div class="space-y-3">
          <h2 class="font-display text-xl font-bold text-[var(--foreground)] tracking-tight">9. Cookies</h2>
          <p>
            This Site may use essential cookies or local storage to maintain basic functionality.
            We do not currently use analytics or advertising cookies.
          </p>
        </div>

        <div class="space-y-3">
          <h2 class="font-display text-xl font-bold text-[var(--foreground)] tracking-tight">10. Changes to this policy</h2>
          <p>
            We may update this Privacy Policy from time to time. The date at the top of this page
            reflects the most recent revision. Continued use of the Site after any update
            constitutes acceptance of the revised policy.
          </p>
        </div>

        <div class="space-y-3">
          <h2 class="font-display text-xl font-bold text-[var(--foreground)] tracking-tight">11. Contact us</h2>
          <p>For any privacy-related questions, contact us:</p>
          <address class="not-italic space-y-0.5 text-sm">
            <p class="font-bold text-[var(--foreground)]">Mansha Enterprises</p>
            <p>Alamgirnagar, Ahmednagar</p>
            <p>📞 <a href="tel:+917262080880" class="text-primary hover:underline">+91 72620 80880</a></p>
            <p>✉️ <a href="mailto:mansha.enterprises.anagar@gmail.com" class="text-primary hover:underline">mansha.enterprises.anagar@gmail.com</a></p>
          </address>
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
