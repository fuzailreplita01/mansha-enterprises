---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import RepairForm from '../components/RepairForm.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
---

<BaseLayout
  title="Contact Us — Mobiles, AC & Purifiers Ahmednagar"
  description="Contact Mansha Enterprises in Alamgirnagar, Ahmednagar. Retail sales, installation, and service for Mobiles, AC, and Water Purifiers. Call +917262080880."
>
  <PageHero
    eyebrow="Get in touch"
    title="Contact Mansha Enterprises in <span class='bg-clip-text text-transparent bg-gradient-to-r from-brand via-brand-accent to-brand'>Ahmednagar.</span>"
    subtitle="<strong>Call, WhatsApp, or drop into our showroom.</strong> Most product and service enquiries are answered within a few hours."
  />

  <section class="bg-[var(--muted)] py-12 sm:py-16">
    <div class="container-page">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 items-start">

        <!-- Left: contact details + hours -->
        <div class="space-y-4">

          <!-- Contact info card -->
          <div class="card-chrome p-5 sm:p-6 space-y-6">
            <h2 class="font-display text-base font-bold text-[var(--foreground)] tracking-tight">Contact details</h2>

            <ul class="space-y-5" role="list">
              <li class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-2xl bg-brand/10 flex items-center justify-center text-primary border border-brand/20 shadow-[0_0_15px_rgba(250,255,105,0.1)] shrink-0 mt-0.5">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>
                  </svg>
                </div>
                <div>
                  <p class="text-[10px] font-semibold text-[var(--muted-foreground)] uppercase tracking-wide">Address</p>
                  <p class="text-sm text-[var(--foreground)] mt-0.5 font-medium leading-relaxed">Alamgirnagar, Ahmednagar, Maharashtra</p>
                </div>
              </li>

              <li class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-2xl bg-brand/10 flex items-center justify-center text-primary border border-brand/20 shadow-[0_0_15px_rgba(250,255,105,0.1)] shrink-0 mt-0.5">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.63A2 2 0 012 .97h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91A16 16 0 0015.1 17.9l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-[10px] font-semibold text-[var(--muted-foreground)] uppercase tracking-wide">Phone</p>
                  <a href="tel:+917262080880" class="text-sm text-primary hover:underline font-semibold mt-0.5 block">+91 72620 80880</a>
                </div>
              </li>

              <li class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-2xl bg-green-500/10 flex items-center justify-center text-green-600 dark:text-green-500 border border-green-500/20 shadow-[0_0_15px_rgba(34,197,94,0.1)] shrink-0 mt-0.5">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/><path d="M12 0C5.373 0 0 5.373 0 12c0 2.025.507 3.934 1.395 5.61L0 24l6.545-1.371A11.945 11.945 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.794 9.794 0 01-5.003-1.373l-.36-.213-3.882.814.822-3.787-.234-.389A9.786 9.786 0 012.182 12c0-5.414 4.404-9.818 9.818-9.818 5.414 0 9.818 4.404 9.818 9.818 0 5.414-4.404 9.818-9.818 9.818z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-[10px] font-semibold text-[var(--muted-foreground)] uppercase tracking-wide">WhatsApp</p>
                  <a
                    href={`https://wa.me/917262080880?text=${encodeURIComponent("Hi, I'd like to get in touch with Mansha Enterprises.")}`}
                    target="_blank" rel="noopener noreferrer"
                    class="text-sm text-green-600 dark:text-green-500 font-semibold transition-colors mt-0.5 block hover:opacity-80"
                  >+91 72620 80880</a>
                </div>
              </li>

              <li class="flex items-start gap-4">
                <div class="w-10 h-10 rounded-2xl bg-brand/10 flex items-center justify-center text-primary border border-brand/20 shadow-[0_0_15px_rgba(250,255,105,0.1)] shrink-0 mt-0.5">
                  <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/>
                  </svg>
                </div>
                <div>
                  <p class="text-[10px] font-semibold text-[var(--muted-foreground)] uppercase tracking-wide">Email</p>
                  <a href="mailto:mansha.enterprises.anagar@gmail.com" class="text-sm text-primary hover:underline transition-colors mt-0.5 block font-medium">mansha.enterprises.anagar@gmail.com</a>
                </div>
              </li>
            </ul>

            <!-- Action buttons -->
            <div class="flex flex-col gap-3 pt-4 border-t border-[var(--border)]">
              <a
                href="tel:+917262080880"
                class="inline-flex items-center justify-center h-12 px-8 rounded-full bg-[#0A0A0A] dark:bg-white text-white dark:text-[#0A0A0A] text-sm font-semibold transition-all shadow-md hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand focus-visible:ring-offset-[var(--background)] w-full"
              >
                Call Now
              </a>
              <WhatsAppButton
                message="Hi, I'd like to get in touch with Mansha Enterprises."
                label="WhatsApp Us"
                size="md"
                variant="outline"
                fullWidth
              />
            </div>
          </div>

          <!-- Opening hours card -->
          <div class="card-chrome p-5 space-y-3">
            <h2 class="text-sm font-bold text-[var(--foreground)] tracking-tight flex items-center gap-2">
              <svg class="w-4 h-4 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
              </svg>
              Opening hours
            </h2>
            <table class="w-full text-xs text-[var(--muted-foreground)]" aria-label="Opening hours">
              <tbody>
                {[
                  { day: 'Monday – Saturday', hours: '9:00 AM – 8:00 PM' },
                  { day: 'Sunday',            hours: '10:00 AM – 6:00 PM' },
                ].map(({ day, hours }) => (
                  <tr class="border-b border-[var(--border)] last:border-0">
                    <td class="py-2 font-medium text-[var(--foreground)]">{day}</td>
                    <td class="py-2 text-right">{hours}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <div class="flex items-center gap-1.5 text-xs text-[var(--muted-foreground)]">
              <span class="w-1.5 h-1.5 rounded-full bg-[#4ade80] shrink-0 animate-pulse"></span>
              Open now — walk-ins welcome
            </div>
          </div>
        </div>

        <!-- Right: map + enquiry form -->
        <div class="lg:col-span-2 space-y-6">

          <!-- Google Map embed -->
          <div class="card-chrome overflow-hidden">
            <div class="relative w-full" style="aspect-ratio:16/7;">
              <iframe
                src="https://maps.google.com/maps?q=Alamgirnagar,+Ahmednagar,+Maharashtra,+India&output=embed&z=15"
                width="100%" height="100%"
                style="border:0; filter: grayscale(20%);"
                allowfullscreen="" loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                title="Mansha Enterprises location on Google Maps"
                class="absolute inset-0 w-full h-full"
              ></iframe>
              <div class="absolute inset-0 flex items-center justify-center bg-[var(--muted)] text-[var(--muted-foreground)] text-sm -z-10">
                Loading map…
              </div>
            </div>
            <div class="px-4 py-3 flex items-center justify-between border-t border-[var(--border)] bg-[var(--card)]">
              <p class="text-xs text-[var(--muted-foreground)] flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-primary shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
                Alamgirnagar, Ahmednagar
              </p>
              <a
                href="https://maps.app.goo.gl/gA9KWfFy7YfJPKBE7"
                target="_blank" rel="noopener noreferrer"
                class="text-xs text-primary hover:underline font-semibold transition-colors"
              >Open in Maps →</a>
            </div>
          </div>

          <!-- Enquiry form -->
          <RepairForm title="Send us a message" context="contact page" />
        </div>

      </div>
    </div>
  </section>
</BaseLayout>
