---
/**
 * Buy Second-Hand Phones page.
 * Listings are fetched from the `phones` Supabase table at build time (SSG).
 * Redeploy to refresh stock. Filters to rows where sold = false.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import PhoneCard from '../components/PhoneCard.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import { supabase } from '../db/supabase.js';

let phones: {
  model: string; brand: string; storage: string; color: string;
  condition: 'Excellent' | 'Good' | 'Fair'; price: string;
  notes?: string; whatsappMsg: string;
}[] = [];

try {
  if (!supabase) throw new Error('PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_ANON_KEY not set in build environment');

  const { data, error } = await supabase
    .from('phones')
    .select('*')
    .eq('sold', false)
    .order('created_at', { ascending: false });

  if (error) throw error;

  phones = (data ?? []).map((p) => {
    const model   = p.model ?? p.name ?? '';
    const brand   = p.brand ?? p.make ?? '';
    const storage = p.storage ?? p.capacity ?? '';
    const color   = p.color ?? p.colour ?? '';
    const rawCond = p.condition ?? p.grade ?? 'Good';
    const price   = typeof p.price === 'number'
                      ? `₹${p.price.toLocaleString('en-IN')}`
                      : (p.price ?? '');

    return {
      model,
      brand,
      storage,
      color,
      condition: (['Excellent', 'Good', 'Fair'].includes(rawCond) ? rawCond : 'Good') as 'Excellent' | 'Good' | 'Fair',
      price,
      notes:       p.notes ?? p.description ?? undefined,
      whatsappMsg: p.whatsapp_msg ?? p.whatsapp_message ??
                   `Hi, I am interested in the ${brand} ${model} (${storage}) listed for ${price}. Is it still available?`,
    };
  });
} catch (err) {
  console.error('[buy-phones] Supabase fetch failed:', err);
}
---

<BaseLayout
  title="Pre-owned Mobiles & Smartphones Ahmednagar"
  description="Buy tested second-hand mobiles in Ahmednagar — iPhone, Samsung, OnePlus & more at Mansha Enterprises in Alamgirnagar. Call +917262080880."
>

  <!-- ── Page header ── -->
  <PageHero
    eyebrow="Pre-owned phones"
    title="Buy Pre-owned Mobiles in Ahmednagar."
    subtitle="Every smartphone is thoroughly tested and graded by our technicians. Honest condition ratings, transparent pricing — what you see is what you get."
  >
    <!-- Condition legend -->
    <div class="mt-6 flex flex-wrap gap-2.5 text-[10px] font-bold uppercase tracking-wider">
      {[
        { label: 'Excellent', cls: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20' },
        { label: 'Good',      cls: 'bg-blue-500/10 text-blue-400 border-blue-500/20' },
        { label: 'Fair',      cls: 'bg-amber-500/10 text-amber-400 border-amber-500/20' },
      ].map(({ label, cls }) => (
        <span class:list={['inline-flex items-center gap-1 px-2 py-0.5 rounded-full border', cls]}>
          {label}
        </span>
      ))}
      <span class="text-primary/70 self-center capitalize tracking-normal text-xs font-medium italic">— Condition grades by our technicians</span>
    </div>
  </PageHero>

  <!-- ── Phone listings grid ── -->
  <section class="bg-[var(--muted)] py-12 sm:py-16" aria-labelledby="phones-grid-heading">
    <div class="container-page">
      <h2 id="phones-grid-heading" class="sr-only">Available phones</h2>

      {phones.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
          {phones.map(phone => (
            <PhoneCard
              model={phone.model}
              brand={phone.brand}
              storage={phone.storage}
              color={phone.color}
              condition={phone.condition}
              price={phone.price}
              notes={phone.notes}
              whatsappMsg={phone.whatsappMsg}
            />
          ))}
        </div>
      ) : (
        /* Empty state */
        <div class="card-chrome p-6 sm:p-12 text-center max-w-md mx-auto">
          <div class="w-12 h-12 rounded-2xl bg-brand/10 flex items-center justify-center text-primary border border-brand/20 shadow-[0_0_15px_rgba(250,255,105,0.15)] mx-auto mb-5" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/></svg>
          </div>
          <h3 class="font-display font-semibold text-[var(--foreground)] text-lg">No phones listed right now</h3>
          <p class="text-sm text-[var(--muted-foreground)] mt-2 mb-6 leading-relaxed">New pre-owned stock arrives regularly. WhatsApp us with your requirements.</p>
          <WhatsAppButton 
            message="Hi, I'm looking for a pre-owned smartphone. Can you help?" 
            label="Ask About Stock" 
            size="md" 
            variant="outline" 
            class="w-full sm:w-auto h-12 sm:h-11"
          />
        </div>
      )}
    </div>
  </section>

  <!-- ── Can't find what you need ── -->
  <section class="py-16 sm:py-24 bg-[var(--background)] border-t border-[var(--border)] relative overflow-hidden" aria-labelledby="phones-cta-heading">
    <!-- Ambient brand glow -->
    <div class="pointer-events-none absolute inset-0 flex items-center justify-center" aria-hidden="true">
      <div class="w-[800px] h-[400px] rounded-full opacity-10" style="background: radial-gradient(ellipse at center, rgba(250,255,105,0.5) 0%, transparent 65%);"></div>
    </div>
    
    <div class="container-page text-center relative z-10">
      <h2 id="phones-cta-heading" class="font-display heading-tight text-2xl sm:text-4xl text-[var(--foreground)]">
        Can't find the model you need?
      </h2>
      <p class="mt-3 text-sm text-[var(--muted-foreground)] max-w-sm mx-auto">
        Tell us your preferred brand, storage, and budget — we'll let you know when the right phone comes in.
      </p>
      
      <div class="mt-8 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 w-full max-w-md mx-auto sm:max-w-none">
        <WhatsAppButton
          message="Hi, I'm looking for a specific pre-owned phone. My requirements are: "
          label="Tell Us What You Need"
          size="md"
          variant="outline"
          class="w-full sm:w-auto h-12 sm:h-11"
        />
        <a
          href="tel:+917262080880"
          class="inline-flex items-center justify-center h-12 sm:h-11 px-8 rounded-full bg-[#0A0A0A] dark:bg-white text-white dark:text-[#0A0A0A] text-sm font-semibold transition-all shadow-md hover:shadow-lg focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:ring-brand focus-visible:ring-offset-[var(--background)] w-full sm:w-auto"
        >
          Call Us
        </a>
      </div>
    </div>
  </section>

</BaseLayout>
