---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Admin Profile">
  <div class="max-w-2xl mx-auto space-y-6 sm:space-y-8">
    <header class="flex items-center gap-2.5">
      <div class="w-9 h-9 rounded-xl bg-brand/10 flex items-center justify-center text-brand border border-brand/20 shadow-[0_0_15px_rgba(250,255,105,0.10)]">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold tracking-tight">Admin Profile</h1>
        <p class="text-muted-foreground text-xs sm:text-sm font-medium">Manage your administrative account settings.</p>
      </div>
    </header>

    <div class="bg-card border border-border rounded-[1.5rem] sm:rounded-[2rem] shadow-xl p-5 sm:p-8 md:p-10 relative overflow-hidden">
      <!-- Glow decoration -->
      <div class="absolute -top-24 -right-24 w-64 h-64 bg-brand/5 blur-[80px] rounded-full -z-0"></div>

      <div class="relative z-10 space-y-6 sm:space-y-8">
        <!-- User Profile Card -->
        <div class="flex flex-col sm:flex-row items-center gap-4 sm:gap-6 pb-6 sm:pb-8 border-b border-border">
          <div class="relative w-20 h-20 sm:w-24 sm:h-24 rounded-2xl sm:rounded-3xl bg-brand/10 flex items-center justify-center text-brand border border-brand/20 shadow-lg shadow-brand/5 shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8 sm:w-10 sm:h-10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            <div class="absolute -bottom-1.5 -right-1.5 w-5 h-5 sm:w-6 sm:h-6 rounded-full bg-brand flex items-center justify-center border-4 border-card text-card-foreground">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-2 h-2 sm:w-2.5 sm:h-2.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
            </div>
          </div>
          <div class="text-center sm:text-left space-y-1 sm:space-y-1.5">
            <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-brand/10 border border-brand/20">
              <span class="w-1 h-1 rounded-full bg-brand animate-pulse"></span>
              <span class="text-[8px] font-black uppercase tracking-widest text-brand">System Owner</span>
            </div>
            <h2 class="text-xl sm:text-2xl font-black tracking-tight text-foreground">Administrator</h2>
            <p id="admin-email" class="text-xs font-mono text-muted-foreground bg-muted/50 px-2.5 py-0.5 rounded-lg border border-border inline-block">Loading email...</p>
          </div>
        </div>

        <!-- Account Info Details Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div class="p-4 sm:p-5 rounded-xl sm:rounded-2xl bg-muted/20 border border-border/80 flex items-center justify-between group hover:border-brand/20 transition-colors">
            <div class="space-y-0.5">
              <p class="text-[9px] font-bold text-muted-foreground uppercase tracking-widest">Access Status</p>
              <p class="text-xs sm:text-sm font-bold text-foreground">Full Admin Rights</p>
            </div>
            <div class="w-8 h-8 rounded-xl bg-green-500/10 flex items-center justify-center text-green-600 dark:text-green-400 border border-green-500/20 shadow-sm shadow-green-500/5">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
            </div>
          </div>
          
          <div class="p-4 sm:p-5 rounded-xl sm:rounded-2xl bg-muted/20 border border-border/80 flex items-center justify-between group hover:border-brand/20 transition-colors">
            <div class="space-y-0.5">
              <p class="text-[9px] font-bold text-muted-foreground uppercase tracking-widest">Last Sign In</p>
              <p id="admin-last-sign-in" class="text-xs sm:text-sm font-bold text-foreground font-mono">...</p>
            </div>
            <div class="w-8 h-8 rounded-xl bg-brand/10 flex items-center justify-center text-brand border border-brand/20 shadow-sm">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            </div>
          </div>
        </div>

        <!-- Notification Message Banner -->
        <div id="status-message" class="hidden text-xs p-4 rounded-2xl border text-center transition-all animate-in fade-in slide-in-from-top-2"></div>

        <!-- Security Actions Section -->
        <div class="pt-4 border-t border-border">
          <h3 class="text-[9px] font-bold text-muted-foreground uppercase tracking-widest mb-4">Security Settings</h3>
          <div class="grid grid-cols-1 gap-4">
            <button id="reset-password-btn" class="flex items-center justify-between p-4 sm:p-6 rounded-2xl bg-card border border-border hover:bg-brand/5 hover:border-brand/20 transition-all duration-300 group hover:scale-[1.01] active:scale-[0.99] cursor-pointer shadow-sm">
              <div class="flex items-center gap-3 sm:gap-4">
                <div class="w-10 h-10 sm:w-12 sm:h-12 rounded-xl bg-brand/5 text-brand group-hover:bg-brand/10 flex items-center justify-center border border-brand/10 transition-colors">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                </div>
                <div class="text-left space-y-0.5">
                  <p class="font-bold text-xs sm:text-sm text-foreground">Change Password via Email Link</p>
                  <p class="text-[10px] sm:text-xs text-muted-foreground font-medium">Receive a secure reset link in your inbox</p>
                </div>
              </div>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-brand group-hover:translate-x-1.5 transition-transform"><path d="m9 18 6-6-6-6"/></svg>
            </button>
          </div>
        </div>

      </div>
    </div>
  </div>
</AdminLayout>

<script>
  import { supabase } from '../../db/supabase';

  const statusMsg = document.getElementById('status-message');

  function showMessage(text: string, isError: boolean) {
    if (!statusMsg) return;
    statusMsg.className = 'text-xs p-4 rounded-2xl border text-center transition-all animate-in fade-in slide-in-from-top-2';
    if (isError) {
      statusMsg.classList.add('bg-destructive/10', 'border-destructive/20', 'text-destructive');
    } else {
      statusMsg.classList.add('bg-green-500/10', 'border-green-500/20', 'text-green-600', 'dark:text-green-400');
    }
    statusMsg.textContent = text;
    statusMsg.classList.remove('hidden');
  }

  async function loadProfile() {
    if (!supabase) return;

    const { data: { user } } = await supabase.auth.getUser();
    
    if (user) {
      document.getElementById('admin-email')!.textContent = user.email || 'Admin User';
      document.getElementById('admin-last-sign-in')!.textContent = user.last_sign_in_at ? new Date(user.last_sign_in_at).toLocaleString() : 'Just now';
    }
  }

  document.getElementById('reset-password-btn')?.addEventListener('click', async () => {
    const email = document.getElementById('admin-email')!.textContent;
    if (!email || email === 'Loading email...') return;

    if (confirm(`Send password reset link to ${email}?`)) {
      showMessage('Sending secure reset link to your email...', false);

      const { error } = await supabase!.auth.resetPasswordForEmail(email, {
        redirectTo: `${window.location.origin}/admin/login`,
      });

      if (error) {
        showMessage('Error: ' + error.message, true);
      } else {
        showMessage('A password reset link has been successfully dispatched to your email address. Please inspect your inbox.', false);
      }
    }
  });

  loadProfile();
</script>
